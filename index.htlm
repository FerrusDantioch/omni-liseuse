<!DOCTYPE html>
<html lang="fr" data-theme="nuit">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Omni-Liseuse — liseuse numérique locale pour EPUB, TXT, HTML, CBZ et CBR.">
  <meta name="theme-color" id="metaThemeColor" content="#171226">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Omni-Liseuse">
  <title>Omni-Liseuse</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <style>
    /* ============================================================
       OMNI-LISEUSE — THÈMES ET BASE VISUELLE
       ============================================================ */
    :root {
      --reader-font-size: 19px;
      --accent: #6d4aff;
      --accent-soft: rgba(109, 74, 255, .16);
      --danger: #d95168;
      --radius: 18px;
      --shadow: 0 18px 55px rgba(0, 0, 0, .20);
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-right: env(safe-area-inset-right, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-left: env(safe-area-inset-left, 0px);
    }

    html[data-theme="clair"] {
      color-scheme: light;
      --bg: #faf0e6;
      --paper: #faf0e6;
      --reader-bg: #f3e7d9;
      --panel: #fffaf3;
      --panel-2: #f4e7d8;
      --ink: #2b2b2b;
      --muted: #756d64;
      --line: rgba(43, 43, 43, .12);
      --cover-shadow: rgba(73, 48, 29, .22);
      --button: rgba(255, 255, 255, .55);
      --button-hover: rgba(255, 255, 255, .90);
    }

    html[data-theme="sombre"] {
      color-scheme: dark;
      --bg: #1a1a1a;
      --paper: #1a1a1a;
      --reader-bg: #121212;
      --panel: #242424;
      --panel-2: #2d2d2d;
      --ink: #dcdcdc;
      --muted: #9f9f9f;
      --line: rgba(220, 220, 220, .12);
      --cover-shadow: rgba(0, 0, 0, .55);
      --button: rgba(255, 255, 255, .055);
      --button-hover: rgba(255, 255, 255, .11);
    }

    html[data-theme="nuit"] {
      color-scheme: dark;
      --bg: #171226;
      --paper: #1e1633;
      --reader-bg: #171226;
      --panel: #211837;
      --panel-2: #2b2046;
      --ink: #cfc4ea;
      --muted: #998db8;
      --line: rgba(207, 196, 234, .13);
      --cover-shadow: rgba(4, 1, 14, .62);
      --button: rgba(148, 117, 255, .075);
      --button-hover: rgba(148, 117, 255, .16);
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }

    html, body {
      width: 100%;
      min-height: 100%;
      margin: 0;
      overscroll-behavior: none;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
      transition: background-color .16s ease, color .16s ease;
    }

    html[data-theme="nuit"] body {
      background:
        radial-gradient(circle at 85% -10%, rgba(109, 74, 255, .15), transparent 38%),
        radial-gradient(circle at -10% 100%, rgba(78, 42, 137, .14), transparent 40%),
        var(--bg);
    }

    button, input { font: inherit; }
    button { color: inherit; }
    button:focus-visible, input:focus-visible {
      outline: 3px solid color-mix(in srgb, var(--accent) 72%, white);
      outline-offset: 3px;
    }

    button {
      border: 0;
      cursor: pointer;
      touch-action: manipulation;
    }

    button:disabled {
      cursor: default;
      opacity: .42;
    }

    svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      pointer-events: none;
    }

    .icon-button {
      width: 44px;
      height: 44px;
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 14px;
      background: var(--button);
      transition: background .15s ease, transform .15s ease;
    }

    .icon-button:hover { background: var(--button-hover); }
    .icon-button:active { transform: scale(.94); }

    .primary-button, .secondary-button {
      min-height: 48px;
      padding: 12px 20px;
      border-radius: 15px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .primary-button {
      color: white;
      background: linear-gradient(135deg, #7957ff, #5935dc);
      box-shadow: 0 10px 26px rgba(109, 74, 255, .26);
    }

    .primary-button:active { transform: translateY(1px); }

    .secondary-button {
      background: var(--button);
      border: 1px solid var(--line);
    }

    .danger-button {
      color: #fff;
      background: var(--danger);
    }

    /* ============================================================
       BIBLIOTHÈQUE
       ============================================================ */
    .view { min-height: 100dvh; }

    #libraryView {
      padding: var(--safe-top) var(--safe-right) var(--safe-bottom) var(--safe-left);
    }

    .library-header {
      width: min(1220px, 100%);
      margin: 0 auto;
      padding: 24px clamp(18px, 4vw, 42px) 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: flex;
      align-items: center;
      min-width: 0;
      gap: 13px;
    }

    .brand img {
      width: 52px;
      height: 52px;
      border-radius: 15px;
      box-shadow: 0 8px 24px rgba(109, 74, 255, .25);
    }

    .brand h1 {
      margin: 0;
      font-family: "EB Garamond", Georgia, serif;
      font-size: clamp(27px, 4vw, 37px);
      line-height: 1;
      letter-spacing: -.025em;
    }

    .brand p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .library-main {
      width: min(1160px, 100%);
      margin: 0 auto;
      padding: 8px clamp(18px, 4vw, 42px) 42px;
    }

    .import-panel {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 142px;
      padding: clamp(22px, 4vw, 34px);
      margin: 12px 0 34px;
      overflow: hidden;
      border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--line));
      border-radius: 24px;
      background:
        linear-gradient(120deg, var(--accent-soft), transparent 60%),
        var(--panel);
      transition: border-color .15s ease, transform .15s ease, background .15s ease;
    }

    .import-panel::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      right: -65px;
      top: -95px;
      border-radius: 50%;
      background: rgba(109, 74, 255, .12);
      pointer-events: none;
    }

    .import-panel.dragging {
      transform: scale(1.008);
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 16%, var(--panel));
    }

    .import-copy { position: relative; z-index: 1; }
    .import-copy h2 {
      margin: 0 0 7px;
      font-family: "EB Garamond", Georgia, serif;
      font-size: clamp(23px, 3vw, 30px);
      font-weight: 600;
    }

    .import-copy p {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      font-size: 14px;
    }

    .import-actions {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex: 0 0 auto;
    }

    .import-actions small {
      color: var(--muted);
      font-size: 12px;
    }

    #importProgress {
      position: absolute;
      inset: auto 20px 12px;
      z-index: 2;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
    }

    .section-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin: 0 2px 18px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 18px;
      letter-spacing: .01em;
    }

    .section-heading span {
      color: var(--muted);
      font-size: 13px;
    }

    .book-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
      gap: clamp(20px, 3vw, 30px);
    }

    .book-card {
      min-width: 0;
      animation: card-in .25s ease both;
    }

    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .cover-wrap {
      position: relative;
      margin-bottom: 12px;
    }

    .cover-button {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 2 / 3;
      padding: 0;
      overflow: hidden;
      border-radius: 9px 15px 15px 9px;
      background: var(--panel-2);
      box-shadow: 0 12px 28px var(--cover-shadow);
      user-select: none;
      -webkit-user-select: none;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .cover-button::before {
      content: "";
      position: absolute;
      z-index: 2;
      inset: 0 auto 0 0;
      width: 7px;
      background: linear-gradient(90deg, rgba(0,0,0,.25), rgba(255,255,255,.12), transparent);
      pointer-events: none;
    }

    .cover-button:hover {
      transform: translateY(-4px) rotate(-.4deg);
      box-shadow: 0 18px 34px var(--cover-shadow);
    }

    .cover-button img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      pointer-events: none;
    }

    .delete-book {
      position: absolute;
      z-index: 3;
      top: 8px;
      right: 8px;
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #fff;
      background: rgba(20, 14, 30, .68);
      backdrop-filter: blur(8px);
      opacity: 0;
      transition: opacity .15s ease;
    }

    .cover-wrap:hover .delete-book,
    .delete-book:focus-visible { opacity: 1; }

    .delete-book svg { width: 17px; height: 17px; }

    .book-title {
      margin: 0 0 4px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      font-family: "EB Garamond", Georgia, serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.2;
    }

    .book-author {
      margin: 0;
      overflow: hidden;
      color: var(--muted);
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .book-progress {
      height: 3px;
      margin-top: 10px;
      overflow: hidden;
      border-radius: 4px;
      background: var(--line);
    }

    .book-progress > span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: var(--accent);
    }

    .empty-state {
      padding: 56px 20px;
      color: var(--muted);
      text-align: center;
      border: 1px solid var(--line);
      border-radius: 20px;
    }

    .empty-state strong {
      display: block;
      margin-bottom: 8px;
      color: var(--ink);
      font-family: "EB Garamond", Georgia, serif;
      font-size: 24px;
    }

    .library-footer {
      padding: 0 20px 25px;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
    }

    /* ============================================================
       LISEUSE ET TYPOGRAPHIE
       ============================================================ */
    #readerView {
      height: 100dvh;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--reader-bg);
    }

    .reader-topbar, .reader-footer {
      position: relative;
      z-index: 20;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      background: color-mix(in srgb, var(--paper) 91%, transparent);
      backdrop-filter: blur(18px);
      transition: transform .24s ease, opacity .24s ease;
    }

    .reader-topbar {
      min-height: calc(62px + var(--safe-top));
      padding: calc(9px + var(--safe-top)) calc(12px + var(--safe-right)) 9px calc(12px + var(--safe-left));
      gap: 12px;
      border-bottom: 1px solid var(--line);
    }

    .reader-heading {
      min-width: 0;
      flex: 1;
      text-align: center;
    }

    .reader-heading strong {
      display: block;
      overflow: hidden;
      font-family: "EB Garamond", Georgia, serif;
      font-size: 18px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .reader-heading small {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .reader-stage {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      padding: clamp(16px, 3.2vh, 38px) clamp(22px, 6vw, 84px) clamp(16px, 3vh, 34px);
      overflow: hidden;
      touch-action: pan-y;
      background:
        radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.035) 100%),
        var(--reader-bg);
    }

    #readerSurface {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      background: var(--paper);
      box-shadow: 0 4px 24px rgba(0, 0, 0, .07);
      perspective: 1800px;
      isolation: isolate;
    }

    .reader-viewport {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--paper);
    }

    #epubViewport iframe { background: var(--paper) !important; }

    #textViewport {
      padding: 0;
    }

    .reader-copy {
      margin: 0;
      color: var(--ink);
      font-family: "EB Garamond", Georgia, serif;
      font-size: var(--reader-font-size);
      font-weight: 400;
      line-height: 1.7;
      text-align: justify;
      hyphens: auto;
      -webkit-hyphens: auto;
      column-fill: auto;
      overflow-wrap: break-word;
      orphans: 2;
      widows: 2;
      will-change: transform;
    }

    .reader-copy p { margin: 0 0 .82em; }
    .reader-copy h1, .reader-copy h2, .reader-copy h3,
    .reader-copy h4, .reader-copy h5, .reader-copy h6 {
      margin: 1.15em 0 .55em;
      break-after: avoid;
      font-weight: 600;
      line-height: 1.25;
      text-align: left;
    }

    .reader-copy h1 { font-size: 1.65em; }
    .reader-copy h2 { font-size: 1.4em; }
    .reader-copy h3 { font-size: 1.2em; }
    .reader-copy blockquote {
      margin: 1em 0;
      padding-left: 1em;
      border-left: 3px solid var(--accent);
      font-style: italic;
    }

    .reader-copy img {
      max-width: 100%;
      max-height: 70vh;
      height: auto;
      break-inside: avoid;
    }

    .reader-copy pre {
      max-width: 100%;
      white-space: pre-wrap;
      font: inherit;
      text-align: left;
    }

    .reader-copy a { color: var(--accent); }

    #comicViewport {
      display: grid;
      place-items: center;
      background: color-mix(in srgb, var(--paper) 92%, black);
    }

    #comicImage {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      user-select: none;
      -webkit-user-drag: none;
    }

    .tap-zone {
      position: absolute;
      z-index: 5;
      top: 0;
      bottom: 0;
      padding: 0;
      background: transparent;
      opacity: .6;
    }

    #tapLeft { left: 0; width: 22%; }
    #tapCenter { left: 22%; width: 56%; }
    #tapRight { right: 0; width: 22%; }

    .tap-zone span {
      position: absolute;
      top: 50%;
      display: grid;
      place-items: center;
      width: 34px;
      height: 52px;
      border-radius: 12px;
      color: var(--muted);
      background: var(--button);
      opacity: 0;
      transform: translateY(-50%);
      transition: opacity .15s ease;
      font-size: 28px;
    }

    #tapLeft span { left: 5px; }
    #tapRight span { right: 5px; }
    .tap-zone:hover span { opacity: .55; }

    .reader-footer {
      min-height: calc(48px + var(--safe-bottom));
      justify-content: center;
      gap: 18px;
      padding: 8px calc(18px + var(--safe-right)) calc(8px + var(--safe-bottom)) calc(18px + var(--safe-left));
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
    }

    #pageIndicator {
      min-width: 105px;
      text-align: right;
      white-space: nowrap;
    }

    .reading-progress {
      width: min(330px, 36vw);
      height: 3px;
      overflow: hidden;
      border-radius: 4px;
      background: var(--line);
    }

    #readingProgressBar {
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: var(--accent);
      transition: width .2s ease;
    }

    .swipe-hint { white-space: nowrap; }

    #readerView.chrome-hidden .reader-topbar {
      transform: translateY(-110%);
      opacity: 0;
      pointer-events: none;
    }

    #readerView.chrome-hidden .reader-footer {
      transform: translateY(110%);
      opacity: 0;
      pointer-events: none;
    }

    /* ============================================================
       TOURNEPAGE 3D
       ============================================================ */
    #turnLayer {
      position: absolute;
      z-index: 8;
      inset: 0;
      overflow: hidden;
      visibility: hidden;
      pointer-events: none;
      perspective: 1800px;
    }

    #turnLayer.active { visibility: visible; }

    #turnLeaf {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform-style: preserve-3d;
      will-change: transform, opacity;
    }

    #turnLeaf.next { transform-origin: left center; }
    #turnLeaf.previous { transform-origin: right center; }

    .leaf-face {
      position: absolute;
      inset: 0;
      overflow: hidden;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      color: var(--ink);
      background: var(--paper);
    }

    .leaf-front {
      box-shadow: inset -22px 0 36px -28px rgba(0,0,0,.52);
    }

    .leaf-back {
      transform: rotateY(180deg);
      background:
        linear-gradient(100deg, rgba(0,0,0,.20), transparent 18%, transparent 80%, rgba(0,0,0,.10)),
        var(--paper);
      box-shadow: inset 22px 0 38px -28px rgba(0,0,0,.55);
    }

    .leaf-front::after, .leaf-back::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(90deg, rgba(255,255,255,.10), transparent 8%, transparent 88%, rgba(0,0,0,.16)),
        radial-gradient(circle at 98% 2%, rgba(255,255,255,.25), transparent 14%);
      mix-blend-mode: soft-light;
    }

    #pageShadow {
      position: absolute;
      z-index: 10;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      background: linear-gradient(90deg, rgba(0,0,0,.34), transparent 42%);
      will-change: opacity, transform;
    }

    #pageShadow.previous {
      background: linear-gradient(-90deg, rgba(0,0,0,.34), transparent 42%);
    }

    .snapshot-text {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: var(--paper);
    }

    .snapshot-comic {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: color-mix(in srgb, var(--paper) 92%, black);
    }

    .paper-abstract {
      position: absolute;
      inset: 8% 8%;
      opacity: .13;
    }

    .paper-abstract span {
      display: block;
      width: 100%;
      height: 1px;
      margin-bottom: 2.7vh;
      background: var(--ink);
    }

    .paper-abstract span:nth-child(3n) { width: 91%; }
    .paper-abstract span:nth-child(4n) { width: 96%; }

    #readerLoading {
      position: absolute;
      z-index: 15;
      inset: 0;
      display: grid;
      place-items: center;
      color: var(--muted);
      background: var(--paper);
      text-align: center;
    }

    .loading-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      padding: 24px;
    }

    .spinner {
      width: 34px;
      height: 34px;
      border: 3px solid var(--line);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin .8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ============================================================
       RÉGLAGES, MODALES ET CONFORT OCULAIRE
       ============================================================ */
    #warmthFilter {
      position: fixed;
      z-index: 9000;
      inset: 0;
      pointer-events: none;
      mix-blend-mode: multiply;
      background: rgb(255, 157, 64);
      opacity: 0;
    }

    .panel-backdrop, .modal-backdrop {
      position: fixed;
      z-index: 1000;
      inset: 0;
      background: rgba(7, 4, 15, .52);
      backdrop-filter: blur(4px);
    }

    .side-panel {
      position: fixed;
      z-index: 1001;
      top: 0;
      right: 0;
      width: min(410px, 94vw);
      height: 100dvh;
      padding: calc(20px + var(--safe-top)) calc(22px + var(--safe-right)) calc(24px + var(--safe-bottom)) 22px;
      overflow-y: auto;
      color: var(--ink);
      background: var(--panel);
      box-shadow: var(--shadow);
      animation: panel-in .22s ease both;
    }

    @keyframes panel-in {
      from { transform: translateX(35px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .panel-header h2, .modal h2 {
      margin: 0;
      font-family: "EB Garamond", Georgia, serif;
      font-size: 29px;
      font-weight: 600;
    }

    .setting-group {
      padding: 20px 0;
      border-top: 1px solid var(--line);
    }

    .setting-group h3 {
      margin: 0 0 13px;
      font-size: 13px;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .setting-group > p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .theme-options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .theme-choice {
      min-height: 76px;
      padding: 9px 5px;
      border: 2px solid transparent;
      border-radius: 14px;
      background: var(--button);
      font-size: 12px;
    }

    .theme-choice[aria-pressed="true"] {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .theme-swatch {
      display: block;
      width: 34px;
      height: 27px;
      margin: 0 auto 7px;
      border: 1px solid rgba(127,127,127,.25);
      border-radius: 8px;
    }

    .theme-choice[data-set-theme="clair"] .theme-swatch { background: #faf0e6; }
    .theme-choice[data-set-theme="sombre"] .theme-swatch { background: #1a1a1a; }
    .theme-choice[data-set-theme="nuit"] .theme-swatch {
      background: linear-gradient(135deg, #1e1633 65%, #6d4aff 65%);
    }

    .font-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .font-controls button {
      width: 58px;
      height: 48px;
      border-radius: 14px;
      background: var(--button);
      font-family: "EB Garamond", Georgia, serif;
      font-size: 22px;
    }

    #fontSizeValue {
      min-width: 90px;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .range-row {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--accent);
    }

    #warmthValue {
      min-width: 42px;
      font-variant-numeric: tabular-nums;
      text-align: right;
    }

    .setting-wide-button { width: 100%; }

    .modal-backdrop {
      display: grid;
      place-items: center;
      padding: 20px;
    }

    .modal {
      width: min(520px, 100%);
      max-height: 90dvh;
      padding: clamp(24px, 5vw, 38px);
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: 24px;
      color: var(--ink);
      background: var(--panel);
      box-shadow: var(--shadow);
      animation: modal-in .2s ease both;
    }

    @keyframes modal-in {
      from { opacity: 0; transform: translateY(10px) scale(.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal .modal-icon {
      width: 62px;
      height: 62px;
      margin-bottom: 17px;
      border-radius: 18px;
    }

    .modal p {
      color: var(--muted);
      line-height: 1.65;
    }

    .modal .credit {
      padding: 15px;
      border-radius: 14px;
      color: var(--ink);
      background: var(--accent-soft);
    }

    .modal small { color: var(--muted); }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 24px;
    }

    #toast {
      position: fixed;
      z-index: 10000;
      left: 50%;
      bottom: calc(22px + var(--safe-bottom));
      width: max-content;
      max-width: min(620px, calc(100vw - 32px));
      padding: 13px 18px;
      border: 1px solid var(--line);
      border-radius: 15px;
      color: var(--ink);
      background: var(--panel);
      box-shadow: var(--shadow);
      line-height: 1.45;
      text-align: center;
      transform: translateX(-50%);
      animation: toast-in .2s ease both;
    }

    #toast.error {
      color: #fff;
      background: #8f3043;
      border-color: transparent;
    }

    @keyframes toast-in {
      from { opacity: 0; transform: translate(-50%, 10px); }
      to { opacity: 1; transform: translate(-50%, 0); }
    }

    /* ============================================================
       ADAPTATION MOBILE, PAYSAGE ET ACCESSIBILITÉ
       ============================================================ */
    @media (max-width: 680px) {
      .library-header { align-items: flex-start; }
      .brand p { display: none; }
      .brand img { width: 44px; height: 44px; }
      .import-panel { flex-direction: column; align-items: stretch; text-align: center; }
      .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 18px; }
      .reader-stage { padding-left: 20px; padding-right: 20px; }
      .swipe-hint { display: none; }
      .reading-progress { width: 35vw; }
    }

    @media (orientation: landscape) and (max-height: 620px) {
      .reader-topbar { min-height: calc(50px + var(--safe-top)); padding-top: calc(5px + var(--safe-top)); padding-bottom: 5px; }
      .reader-footer { min-height: calc(38px + var(--safe-bottom)); padding-top: 5px; }
      .reader-stage { padding-top: 12px; padding-bottom: 12px; }
      .reader-heading small { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>

<body>
  <!-- Filtre ambre : toujours non interactif -->
  <div id="warmthFilter" aria-hidden="true"></div>

  <div id="app">
    <!-- ========================================================
         ÉCRAN BIBLIOTHÈQUE
         ======================================================== -->
    <section id="libraryView" class="view" aria-label="Bibliothèque Omni-Liseuse">
      <header class="library-header">
        <div class="brand">
          <img id="brandIcon" alt="" width="52" height="52">
          <div>
            <h1>Omni-Liseuse</h1>
            <p>Vos livres. Votre appareil. Rien d’autre.</p>
          </div>
        </div>
        <div class="header-actions">
          <button id="installButton" class="icon-button" title="Installer Omni-Liseuse" aria-label="Installer Omni-Liseuse" hidden>
            <svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
          </button>
          <button id="librarySettingsButton" class="icon-button" title="Réglages" aria-label="Ouvrir les réglages">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.08A1.7 1.7 0 0 0 8.94 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15 1.7 1.7 0 0 0 3.08 14H3v-4h.08A1.7 1.7 0 0 0 4.6 8.94a1.7 1.7 0 0 0-.34-1.88L4.2 7l2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3.08V3h4v.08A1.7 1.7 0 0 0 15.06 4.6a1.7 1.7 0 0 0 1.88-.34L17 4.2 19.8 7l-.06.06a1.7 1.7 0 0 0-.34 1.88A1.7 1.7 0 0 0 20.92 10H21v4h-.08A1.7 1.7 0 0 0 19.4 15Z"/></svg>
          </button>
          <button id="aboutButton" class="icon-button" title="À propos" aria-label="À propos d’Omni-Liseuse">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg>
          </button>
        </div>
      </header>

      <main class="library-main">
        <section id="dropZone" class="import-panel" aria-label="Zone d’import de livres">
          <div class="import-copy">
            <h2>Ajoutez à votre bibliothèque</h2>
            <p>EPUB, TXT, HTML, CBZ et CBR · sélection multiple acceptée<br>Import et lecture entièrement locaux.</p>
          </div>
          <div class="import-actions">
            <button id="importButton" class="primary-button">
              <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
              Importer un livre
            </button>
            <small>ou glissez-déposez vos fichiers ici</small>
          </div>
          <input id="fileInput" type="file" multiple hidden
                 accept=".epub,.txt,.html,.htm,.cbz,.cbr,application/epub+zip,text/plain,text/html">
          <div id="importProgress" role="status" hidden></div>
        </section>

        <div class="section-heading">
          <h2>Ma bibliothèque</h2>
          <span id="bookCount">0 livre</span>
        </div>

        <div id="bookGrid" class="book-grid"></div>
        <div id="emptyState" class="empty-state">
          <strong>Votre bibliothèque est prête</strong>
          Importez un premier livre avec le bouton ci-dessus ou par glisser-déposer.<br>
          Un appui long sur une couverture permet de supprimer un livre.
        </div>
      </main>

      <footer class="library-footer">
        Omni-Liseuse · aucun compte · aucune synchronisation · aucune donnée de lecture transmise
      </footer>
    </section>

    <!-- ========================================================
         ÉCRAN DE LECTURE
         ======================================================== -->
    <section id="readerView" aria-label="Lecture" hidden>
      <header class="reader-topbar">
        <button id="readerBackButton" class="icon-button" title="Retour à la bibliothèque" aria-label="Retour à la bibliothèque">
          <svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="reader-heading">
          <strong id="readerBookTitle">Lecture</strong>
          <small>Omni-Liseuse</small>
        </div>
        <button id="warmQuickButton" class="icon-button" title="Activer ou couper le filtre chaud" aria-label="Activer ou couper le filtre chaud">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <button id="readerSettingsButton" class="icon-button" title="Réglages de lecture" aria-label="Ouvrir les réglages de lecture">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="8" cy="18" r="2" fill="currentColor" stroke="none"/></svg>
        </button>
      </header>

      <main id="readerStage" class="reader-stage">
        <div id="readerSurface">
          <div id="epubViewport" class="reader-viewport" hidden></div>
          <div id="textViewport" class="reader-viewport" hidden>
            <article id="textContent" class="reader-copy"></article>
          </div>
          <div id="comicViewport" class="reader-viewport" hidden>
            <img id="comicImage" alt="Page de bande dessinée" draggable="false">
          </div>

          <div id="turnLayer" aria-hidden="true">
            <div id="pageShadow"></div>
            <div id="turnLeaf">
              <div id="leafFront" class="leaf-face leaf-front"></div>
              <div class="leaf-face leaf-back"></div>
            </div>
          </div>

          <div id="readerLoading">
            <div class="loading-box">
              <div class="spinner" aria-hidden="true"></div>
              <span id="readerLoadingText">Ouverture du livre…</span>
            </div>
          </div>
        </div>

        <button id="tapLeft" class="tap-zone" aria-label="Page précédente"><span>‹</span></button>
        <button id="tapCenter" class="tap-zone" aria-label="Afficher ou masquer les commandes"></button>
        <button id="tapRight" class="tap-zone" aria-label="Page suivante"><span>›</span></button>
      </main>

      <footer class="reader-footer">
        <span id="pageIndicator">Lecture</span>
        <div class="reading-progress" aria-hidden="true"><div id="readingProgressBar"></div></div>
        <span class="swipe-hint">Glissez pour tourner la page</span>
      </footer>
    </section>
  </div>

  <!-- ========================================================
       PANNEAU DE RÉGLAGES
       ======================================================== -->
  <div id="panelBackdrop" class="panel-backdrop" hidden></div>
  <aside id="settingsPanel" class="side-panel" aria-label="Réglages" hidden>
    <div class="panel-header">
      <h2>Réglages</h2>
      <button id="closeSettingsButton" class="icon-button" aria-label="Fermer les réglages">
        <svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <section class="setting-group">
      <h3>Thème</h3>
      <div class="theme-options">
        <button class="theme-choice" data-set-theme="clair" aria-pressed="false">
          <span class="theme-swatch"></span>Clair
        </button>
        <button class="theme-choice" data-set-theme="sombre" aria-pressed="false">
          <span class="theme-swatch"></span>Sombre
        </button>
        <button class="theme-choice" data-set-theme="nuit" aria-pressed="true">
          <span class="theme-swatch"></span>Nuit pourpre
        </button>
      </div>
    </section>

    <section class="setting-group">
      <h3>Taille du texte</h3>
      <div class="font-controls">
        <button id="fontMinusButton" aria-label="Diminuer la taille de police">A−</button>
        <span id="fontSizeValue">19 px</span>
        <button id="fontPlusButton" aria-label="Augmenter la taille de police">A+</button>
      </div>
      <p>Plage de 14 à 28 px. La pagination est recalculée automatiquement.</p>
    </section>

    <section class="setting-group">
      <h3>Lumière chaude</h3>
      <div class="range-row">
        <input id="warmthRange" type="range" min="0" max="45" step="5" value="0" aria-label="Intensité du filtre de lumière chaude">
        <span id="warmthValue">0 %</span>
      </div>
      <p>Filtre ambre progressif, sans interception des gestes ni des touches.</p>
      <button id="toggleWarmthButton" class="secondary-button setting-wide-button">Activer le filtre</button>
    </section>

    <section class="setting-group">
      <h3>Affichage et application</h3>
      <button id="fullscreenButton" class="secondary-button setting-wide-button">Passer en plein écran</button>
      <p></p>
      <button id="settingsAboutButton" class="secondary-button setting-wide-button">À propos d’Omni-Liseuse</button>
    </section>
  </aside>

  <!-- À propos -->
  <div id="aboutModal" class="modal-backdrop" hidden>
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="aboutTitle">
      <img id="aboutIcon" class="modal-icon" alt="Icône Omni-Liseuse">
      <h2 id="aboutTitle">Omni-Liseuse</h2>
      <p><strong>Version 1.0.0</strong><br>Liseuse PWA locale pour EPUB, TXT, HTML, CBZ et CBR.</p>
      <p class="credit">Application développée par Ferrus Dantioch avec l'aide de l'IA.</p>
      <p>Toutes les données restent locales sur l’appareil. Les livres, couvertures, positions de lecture et réglages sont conservés dans IndexedDB : aucun livre ni historique de lecture n’est envoyé vers un serveur.</p>
      <p><small id="pwaStatus">Préparation du fonctionnement hors ligne…</small></p>
      <div class="modal-actions">
        <button id="closeAboutButton" class="primary-button">Fermer</button>
      </div>
    </section>
  </div>

  <!-- Confirmation de suppression -->
  <div id="confirmModal" class="modal-backdrop" hidden>
    <section class="modal" role="alertdialog" aria-modal="true" aria-labelledby="confirmTitle">
      <h2 id="confirmTitle">Supprimer ce livre ?</h2>
      <p id="confirmMessage"></p>
      <div class="modal-actions">
        <button id="confirmCancelButton" class="secondary-button">Annuler</button>
        <button id="confirmAcceptButton" class="primary-button danger-button">Supprimer</button>
      </div>
    </section>
  </div>

  <div id="toast" role="status" aria-live="polite" hidden></div>

  <!-- ========================================================
       CDN : Epub.js, JSZip, Dexie.js et prise en charge CBR
       ======================================================== -->
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/epubjs@0.3.93/dist/epub.min.js"></script>
  <script src="https://unpkg.com/dexie@4.0.11/dist/dexie.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/libarchive.js@1.3.0/dist/libarchive.js"></script>

  <script>
  (() => {
    "use strict";

    /* ============================================================
       CONSTANTES, ÉTAT ET UTILITAIRES
       ============================================================ */
    const APP_NAME = "Omni-Liseuse";
    const APP_VERSION = "1.0.0";
    const CACHE_NAME = "omni-liseuse-shell-v1.0.0";
    const ARCHIVE_WORKER = "https://cdn.jsdelivr.net/npm/libarchive.js@1.3.0/dist/worker-bundle.js";
    const CDN_RESOURCES = [
      "https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js",
      "https://cdn.jsdelivr.net/npm/epubjs@0.3.93/dist/epub.min.js",
      "https://unpkg.com/dexie@4.0.11/dist/dexie.min.js",
      "https://cdn.jsdelivr.net/npm/libarchive.js@1.3.0/dist/libarchive.js",
      ARCHIVE_WORKER
    ];

    const $ = id => document.getElementById(id);
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
    const nextFrame = () => new Promise(resolve => requestAnimationFrame(() => resolve()));
    const imagePattern = /\.(jpe?g|png|gif|webp|avif|bmp)$/i;
    const naturalCollator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });

    const readerColors = {
      clair: { paper: "#faf0e6", ink: "#2b2b2b", accent: "#5935dc" },
      sombre: { paper: "#1a1a1a", ink: "#dcdcdc", accent: "#aa96ff" },
      nuit: { paper: "#1e1633", ink: "#cfc4ea", accent: "#a48dff" }
    };

    const prefs = {
      theme: "nuit",
      fontSize: 19,
      warmth: 0,
      lastWarmth: 20
    };

    let db = null;
    let current = null;
    let opening = false;
    let sessionToken = 0;
    let navigationBusy = false;
    let queuedDirection = 0;
    let toastTimer = 0;
    let chromeTimer = 0;
    let fontEngineTimer = 0;
    let deferredInstallPrompt = null;
    let fullscreenPending = false;
    let suppressTapUntil = 0;
    let storageErrorShown = false;
    let archiveInitialized = false;
    let archiveWorkerBlobUrl = null;
    const libraryCoverUrls = new Set();

    function uid() {
      if (crypto.randomUUID) return crypto.randomUUID();
      const bytes = new Uint8Array(16);
      crypto.getRandomValues(bytes);
      return Array.from(bytes, byte => byte.toString(16).padStart(2, "0")).join("");
    }

    function extensionOf(name) {
      const match = /\.([a-z0-9]+)$/i.exec(name || "");
      return match ? match[1].toLowerCase() : "";
    }

    function titleFromFilename(name) {
      return (name || "Sans titre").replace(/\.[^.]+$/, "").replace(/[_]+/g, " ").trim() || "Sans titre";
    }

    function formatLabel(format) {
      return ({ epub: "EPUB", txt: "TXT", html: "HTML", cbz: "CBZ", cbr: "CBR" })[format] || format.toUpperCase();
    }

    function showToast(message, duration = 3600, isError = false) {
      clearTimeout(toastTimer);
      const toast = $("toast");
      toast.textContent = message;
      toast.classList.toggle("error", isError);
      toast.hidden = false;
      toastTimer = setTimeout(() => { toast.hidden = true; }, duration);
    }

    async function withTimeout(promise, milliseconds, message) {
      let timer;
      try {
        return await Promise.race([
          promise,
          new Promise((_, reject) => {
            timer = setTimeout(() => reject(new Error(message)), milliseconds);
          })
        ]);
      } finally {
        clearTimeout(timer);
      }
    }

    function roundedRect(ctx, x, y, width, height, radius) {
      const r = Math.min(radius, width / 2, height / 2);
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + width, y, x + width, y + height, r);
      ctx.arcTo(x + width, y + height, x, y + height, r);
      ctx.arcTo(x, y + height, x, y, r);
      ctx.arcTo(x, y, x + width, y, r);
      ctx.closePath();
    }

    function canvasToBlob(canvas, type = "image/png", quality = .9) {
      return new Promise((resolve, reject) => {
        canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error("Création d’image impossible")), type, quality);
      });
    }

    /* ============================================================
       ICÔNES, COUVERTURES ET MANIFESTE PWA
       ============================================================ */
    function drawBookIcon(canvas) {
      const size = canvas.width;
      const ctx = canvas.getContext("2d");
      const scale = size / 512;
      ctx.scale(scale, scale);

      const gradient = ctx.createLinearGradient(0, 0, 512, 512);
      gradient.addColorStop(0, "#815fff");
      gradient.addColorStop(.55, "#6d4aff");
      gradient.addColorStop(1, "#382170");
      ctx.fillStyle = gradient;
      roundedRect(ctx, 0, 0, 512, 512, 104);
      ctx.fill();

      ctx.fillStyle = "rgba(255,255,255,.09)";
      ctx.beginPath();
      ctx.arc(410, 88, 145, 0, Math.PI * 2);
      ctx.fill();

      ctx.shadowColor = "rgba(20,5,55,.32)";
      ctx.shadowBlur = 24;
      ctx.shadowOffsetY = 14;
      ctx.fillStyle = "#f6f0ff";
      ctx.beginPath();
      ctx.moveTo(105, 145);
      ctx.quadraticCurveTo(177, 124, 246, 163);
      ctx.lineTo(246, 365);
      ctx.quadraticCurveTo(177, 326, 105, 350);
      ctx.closePath();
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(407, 145);
      ctx.quadraticCurveTo(335, 124, 266, 163);
      ctx.lineTo(266, 365);
      ctx.quadraticCurveTo(335, 326, 407, 350);
      ctx.closePath();
      ctx.fill();

      ctx.shadowColor = "transparent";
      ctx.strokeStyle = "#cbbcff";
      ctx.lineWidth = 8;
      ctx.lineCap = "round";
      for (let y = 205; y <= 290; y += 42) {
        ctx.beginPath();
        ctx.moveTo(139, y);
        ctx.quadraticCurveTo(185, y - 8, 218, y + 7);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(373, y);
        ctx.quadraticCurveTo(327, y - 8, 294, y + 7);
        ctx.stroke();
      }
      return canvas;
    }

    function makeIconDataUrl(size) {
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = size;
      drawBookIcon(canvas);
      return canvas.toDataURL("image/png");
    }

    async function generateCover(title, author, format) {
      const canvas = document.createElement("canvas");
      canvas.width = 480;
      canvas.height = 720;
      const ctx = canvas.getContext("2d");

      const gradient = ctx.createLinearGradient(0, 0, 480, 720);
      gradient.addColorStop(0, "#30204f");
      gradient.addColorStop(.6, "#1e1633");
      gradient.addColorStop(1, "#120d21");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 480, 720);

      ctx.fillStyle = "rgba(109,74,255,.28)";
      ctx.beginPath();
      ctx.arc(420, 50, 230, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#6d4aff";
      ctx.fillRect(0, 0, 15, 720);
      ctx.fillRect(54, 82, 72, 7);

      ctx.fillStyle = "#cfc4ea";
      ctx.textBaseline = "top";
      ctx.font = "600 47px 'EB Garamond', Georgia, serif";

      const words = title.split(/\s+/);
      const lines = [];
      let line = "";
      for (const word of words) {
        const candidate = line ? line + " " + word : word;
        if (ctx.measureText(candidate).width > 360 && line) {
          lines.push(line);
          line = word;
        } else {
          line = candidate;
        }
      }
      if (line) lines.push(line);

      let y = 180;
      for (const textLine of lines.slice(0, 6)) {
        ctx.fillText(textLine, 54, y);
        y += 58;
      }

      ctx.fillStyle = "#a99bc9";
      ctx.font = "25px 'EB Garamond', Georgia, serif";
      const authorLines = author.length > 34 ? author.slice(0, 33) + "…" : author;
      ctx.fillText(authorLines, 54, Math.min(y + 35, 545));

      ctx.fillStyle = "#8f78dc";
      ctx.font = "700 18px system-ui, sans-serif";
      ctx.fillText(formatLabel(format), 54, 635);
      ctx.fillStyle = "#75659a";
      ctx.font = "16px system-ui, sans-serif";
      ctx.fillText("OMNI-LISEUSE", 54, 670);

      return canvasToBlob(canvas, "image/jpeg", .88);
    }

    function setupIconsAndManifest() {
      const icon192 = makeIconDataUrl(192);
      const icon512 = makeIconDataUrl(512);
      $("brandIcon").src = icon192;
      $("aboutIcon").src = icon192;

      const favicon = document.createElement("link");
      favicon.rel = "icon";
      favicon.type = "image/png";
      favicon.href = icon192;
      document.head.appendChild(favicon);

      const appleIcon = document.createElement("link");
      appleIcon.rel = "apple-touch-icon";
      appleIcon.href = icon192;
      document.head.appendChild(appleIcon);

      let startUrl = "./";
      let scope = "./";
      if (/^https?:$/.test(location.protocol)) {
        startUrl = location.href.split("#")[0];
        scope = new URL(".", location.href).href;
      }

      const manifest = {
        id: scope,
        name: APP_NAME,
        short_name: APP_NAME,
        description: "Liseuse numérique locale et confortable.",
        lang: "fr",
        start_url: startUrl,
        scope,
        display: "fullscreen",
        display_override: ["fullscreen", "standalone"],
        orientation: "any",
        background_color: "#171226",
        theme_color: "#171226",
        categories: ["books", "education", "entertainment"],
        icons: [
          { src: icon192, sizes: "192x192", type: "image/png", purpose: "any maskable" },
          { src: icon512, sizes: "512x512", type: "image/png", purpose: "any maskable" }
        ]
      };

      const manifestUrl = URL.createObjectURL(new Blob(
        [JSON.stringify(manifest)],
        { type: "application/manifest+json" }
      ));
      const link = document.createElement("link");
      link.rel = "manifest";
      link.href = manifestUrl;
      document.head.appendChild(link);
      window.addEventListener("pagehide", () => URL.revokeObjectURL(manifestUrl), { once: true });
    }

    /* ============================================================
       SERVICE WORKER ET CACHE DE L’APP SHELL
       ============================================================ */
    async function primeOfflineCache() {
      if (!("caches" in window) || !/^https?:$/.test(location.protocol)) return false;
      try {
        const cache = await caches.open(CACHE_NAME);
        const resources = [location.href.split("#")[0], ...CDN_RESOURCES];
        await Promise.allSettled(resources.map(async url => {
          const crossOrigin = !url.startsWith(location.origin);
          const response = await fetch(url, {
            mode: crossOrigin ? "no-cors" : "same-origin",
            credentials: crossOrigin ? "omit" : "same-origin"
          });
          if (response.ok || response.type === "opaque") await cache.put(url, response);
        }));
        return true;
      } catch (error) {
        console.warn("Cache local indisponible :", error);
        return false;
      }
    }

    async function setupServiceWorker() {
      const cached = await primeOfflineCache();

      if (!("serviceWorker" in navigator) || !isSecureContext || !/^https?:$/.test(location.protocol)) {
        $("pwaStatus").textContent = "Lecture locale disponible. L’installation PWA et le service worker nécessitent HTTPS ou localhost.";
        return;
      }

      const appUrl = location.href.split("#")[0];
      const workerSource = `
        const CACHE = ${JSON.stringify(CACHE_NAME)};
        const APP = ${JSON.stringify(appUrl)};
        const CORE = ${JSON.stringify(CDN_RESOURCES)};

        self.addEventListener("install", event => {
          event.waitUntil((async () => {
            const cache = await caches.open(CACHE);
            const urls = [APP].concat(CORE);
            await Promise.allSettled(urls.map(async url => {
              try {
                const cross = !url.startsWith(self.location.origin);
                const response = await fetch(url, {
                  mode: cross ? "no-cors" : "same-origin",
                  credentials: cross ? "omit" : "same-origin"
                });
                if (response.ok || response.type === "opaque") await cache.put(url, response);
              } catch (_) {}
            }));
            await self.skipWaiting();
          })());
        });

        self.addEventListener("activate", event => {
          event.waitUntil((async () => {
            const keys = await caches.keys();
            await Promise.all(keys.filter(key => key.startsWith("omni-liseuse-") && key !== CACHE).map(key => caches.delete(key)));
            await self.clients.claim();
          })());
        });

        self.addEventListener("fetch", event => {
          const request = event.request;
          if (request.method !== "GET") return;
          const url = new URL(request.url);
          if (url.protocol !== "http:" && url.protocol !== "https:") return;

          if (request.mode === "navigate") {
            event.respondWith((async () => {
              try {
                const response = await fetch(request);
                const cache = await caches.open(CACHE);
                await cache.put(APP, response.clone());
                return response;
              } catch (_) {
                return (await caches.match(APP, { ignoreSearch: true })) ||
                       (await caches.match(request)) ||
                       Response.error();
              }
            })());
            return;
          }

          event.respondWith((async () => {
            const cached = await caches.match(request);
            if (cached) return cached;
            try {
              const response = await fetch(request);
              if (response.ok || response.type === "opaque") {
                const cache = await caches.open(CACHE);
                await cache.put(request, response.clone());
              }
              return response;
            } catch (_) {
              return (await caches.match(request, { ignoreSearch: true })) || Response.error();
            }
          })());
        });
      `;

      /*
       * Le code ci-dessous implémente l’enregistrement Blob demandé.
       * Chromium et Safari peuvent toutefois refuser les URL blob: comme
       * scripts de service worker : le CacheStorage ci-dessus constitue
       * alors le repli, sans empêcher la lecture locale.
       */
      const blobUrl = URL.createObjectURL(new Blob([workerSource], { type: "text/javascript" }));
      try {
        const registration = await navigator.serviceWorker.register(blobUrl, { scope: "./" });
        await navigator.serviceWorker.ready;
        console.info("Service worker Omni-Liseuse actif :", registration.scope);
        $("pwaStatus").textContent = "Service worker actif : app shell disponible hors ligne.";
      } catch (error) {
        console.warn("Le navigateur a refusé le service worker Blob :", error);
        $("pwaStatus").textContent = cached
          ? "Cache local préparé. Ce navigateur exige un script service worker HTTP(S) distinct pour garantir un rechargement hors ligne."
          : "Le cache hors ligne n’a pas pu être initialisé dans ce contexte de navigation.";
      } finally {
        setTimeout(() => URL.revokeObjectURL(blobUrl), 1500);
      }
    }

    /* ============================================================
       INDEXEDDB / DEXIE ET PRÉFÉRENCES
       ============================================================ */
    function createDatabase() {
      db = new Dexie("omni-liseuse");
      db.version(1).stores({
        books: "id,title,author,format,addedAt,lastOpenedAt",
        settings: "key"
      });
    }

    async function savePreference(key, value) {
      if (!db) return;
      try {
        await db.settings.put({ key, value });
      } catch (error) {
        console.error("Sauvegarde du réglage impossible :", error);
      }
    }

    async function loadPreferences() {
      const rows = await db.settings.where("key").anyOf(["theme", "fontSize", "warmth", "lastWarmth"]).toArray();
      for (const row of rows) {
        if (row.key === "theme" && readerColors[row.value]) prefs.theme = row.value;
        if (row.key === "fontSize") prefs.fontSize = clamp(Number(row.value) || 19, 14, 28);
        if (row.key === "warmth") prefs.warmth = clamp(Number(row.value) || 0, 0, 45);
        if (row.key === "lastWarmth") prefs.lastWarmth = clamp(Number(row.value) || 20, 5, 45);
      }
    }

    function applyTheme() {
      document.documentElement.dataset.theme = prefs.theme;
      const themeMeta = { clair: "#faf0e6", sombre: "#1a1a1a", nuit: "#171226" };
      $("metaThemeColor").content = themeMeta[prefs.theme];
      document.querySelectorAll("[data-set-theme]").forEach(button => {
        button.setAttribute("aria-pressed", String(button.dataset.setTheme === prefs.theme));
      });
      if (current?.engine?.setTheme) {
        try { current.engine.setTheme(); } catch (error) { console.warn(error); }
      }
    }

    function applyWarmth() {
      const filter = $("warmthFilter");
      filter.style.opacity = String(prefs.warmth / 100);
      filter.style.visibility = prefs.warmth ? "visible" : "hidden";
      $("warmthRange").value = String(prefs.warmth);
      $("warmthValue").textContent = prefs.warmth + " %";
      $("toggleWarmthButton").textContent = prefs.warmth ? "Couper le filtre" : "Activer le filtre";
    }

    function applyFontSize(updateEngine = true) {
      document.documentElement.style.setProperty("--reader-font-size", prefs.fontSize + "px");
      $("fontSizeValue").textContent = prefs.fontSize + " px";
      $("fontMinusButton").disabled = prefs.fontSize <= 14;
      $("fontPlusButton").disabled = prefs.fontSize >= 28;

      if (updateEngine) {
        clearTimeout(fontEngineTimer);
        fontEngineTimer = setTimeout(() => {
          const engine = current?.engine;
          if (!engine) return;
          Promise.resolve(engine.fontChanged ? engine.fontChanged() : engine.resize?.())
            .catch(error => console.warn("Repagination :", error));
        }, 70);
      }
    }

    async function persistPosition(bookId, position, progress) {
      const safeProgress = typeof progress === "number" && Number.isFinite(progress)
        ? clamp(progress, 0, 1)
        : null;
      try {
        const changes = { position, lastOpenedAt: Date.now() };
        if (safeProgress !== null) changes.progress = safeProgress;
        await db.books.update(bookId, changes);
        await db.settings.put({ key: "lastBookId", value: bookId });
        if (current?.record) {
          current.record.position = position;
          if (safeProgress !== null) current.record.progress = safeProgress;
        }
      } catch (error) {
        console.error("Sauvegarde de la position impossible :", error);
        if (!storageErrorShown) {
          storageErrorShown = true;
          showToast("La position n’a pas pu être sauvegardée. Vérifiez le stockage du navigateur.", 6000, true);
        }
      }
    }

    /* ============================================================
       EXTRACTION DES MÉTADONNÉES À L’IMPORT
       ============================================================ */
    async function decodeTextFile(blob) {
      const buffer = await blob.arrayBuffer();
      try {
        return new TextDecoder("utf-8", { fatal: true }).decode(buffer).replace(/^\uFEFF/, "");
      } catch (_) {
        return new TextDecoder("windows-1252").decode(buffer).replace(/^\uFEFF/, "");
      }
    }

    function comicImageNamesFromZip(zip) {
      return Object.values(zip.files)
        .filter(entry => !entry.dir && imagePattern.test(entry.name) && !entry.name.includes("__MACOSX"))
        .sort((a, b) => naturalCollator.compare(a.name, b.name));
    }

    async function prepareBook(file) {
      let format = extensionOf(file.name);
      if (format === "htm") format = "html";
      if (!["epub", "txt", "html", "cbz", "cbr"].includes(format)) {
        throw new Error("Format non pris en charge. Utilisez EPUB, TXT, HTML, CBZ ou CBR.");
      }
      if (!file.size) throw new Error("Le fichier est vide.");

      const record = {
        id: uid(),
        title: titleFromFilename(file.name),
        author: format === "cbz" || format === "cbr" ? "Bande dessinée" : "Auteur inconnu",
        format,
        file,
        cover: null,
        addedAt: Date.now(),
        lastOpenedAt: 0,
        position: null,
        progress: 0
      };

      if (format === "epub") {
        if (!window.ePub || !window.JSZip) {
          throw new Error("Le moteur EPUB n’est pas chargé. Vérifiez la connexion lors du premier chargement.");
        }
        let temporaryBook = null;
        try {
          const buffer = await file.arrayBuffer();
          temporaryBook = ePub(buffer);
          await withTimeout(temporaryBook.ready, 25000, "EPUB illisible ou délai d’analyse dépassé.");
          const metadata = await temporaryBook.loaded.metadata;
          if (metadata?.title) record.title = metadata.title;
          if (metadata?.creator) record.author = metadata.creator;

          try {
            const coverUrl = await withTimeout(temporaryBook.coverUrl(), 9000, "Couverture inaccessible.");
            if (coverUrl && /^(blob:|data:)/.test(coverUrl)) {
              const response = await fetch(coverUrl);
              if (response.ok) record.cover = await response.blob();
              if (coverUrl.startsWith("blob:")) URL.revokeObjectURL(coverUrl);
            }
          } catch (coverError) {
            console.info("Couverture EPUB absente :", coverError);
          }
        } catch (error) {
          throw new Error("EPUB corrompu, protégé ou incomplet : " + (error.message || "analyse impossible"));
        } finally {
          try { temporaryBook?.destroy(); } catch (_) {}
        }
      }

      if (format === "html") {
        const source = await decodeTextFile(file);
        const documentParsed = new DOMParser().parseFromString(source, "text/html");
        const htmlTitle = documentParsed.querySelector("title")?.textContent?.trim();
        const heading = documentParsed.querySelector("h1")?.textContent?.trim();
        const author = documentParsed.querySelector('meta[name="author"]')?.content?.trim();
        if (htmlTitle || heading) record.title = htmlTitle || heading;
        if (author) record.author = author;
      }

      if (format === "txt") {
        record.author = "Document texte";
        await decodeTextFile(file.slice(0, Math.min(file.size, 65536)));
      }

      if (format === "cbz") {
        if (!window.JSZip) throw new Error("Le moteur CBZ n’est pas disponible.");
        try {
          const zip = await JSZip.loadAsync(await file.arrayBuffer());
          const images = comicImageNamesFromZip(zip);
          if (!images.length) throw new Error("Aucune image dans l’archive.");
          record.cover = await images[0].async("blob");
        } catch (error) {
          throw new Error("CBZ corrompu ou sans page lisible : " + (error.message || "archive invalide"));
        }
      }

      if (format === "cbr") {
        const header = new Uint8Array(await file.slice(0, 8).arrayBuffer());
        const signature = [0x52, 0x61, 0x72, 0x21, 0x1a, 0x07];
        if (!signature.every((byte, index) => header[index] === byte)) {
          throw new Error("Archive CBR non valide : signature RAR absente.");
        }
      }

      if (!record.cover) {
        record.cover = await generateCover(record.title, record.author, format);
      }
      return record;
    }

    async function importFiles(files) {
      if (!db || !files.length) return;
      const importButton = $("importButton");
      const progress = $("importProgress");
      importButton.disabled = true;
      progress.hidden = false;

      let imported = 0;
      const errors = [];

      for (let index = 0; index < files.length; index++) {
        const file = files[index];
        progress.textContent = `Import ${index + 1}/${files.length} · ${file.name}`;
        try {
          const record = await prepareBook(file);
          await db.books.add(record);
          imported++;
        } catch (error) {
          console.error("Import impossible :", file.name, error);
          errors.push(`${file.name} — ${error.message || "fichier illisible"}`);
        }
      }

      progress.hidden = true;
      importButton.disabled = false;
      $("fileInput").value = "";
      await renderLibrary();

      if (imported) showToast(`${imported} livre${imported > 1 ? "s" : ""} ajouté${imported > 1 ? "s" : ""} à la bibliothèque.`);
      if (errors.length) {
        const detail = errors.length === 1 ? errors[0] : `${errors.length} fichiers refusés. ${errors[0]}`;
        setTimeout(() => showToast(detail, 8000, true), imported ? 900 : 0);
      }
    }

    /* ============================================================
       AFFICHAGE DE LA BIBLIOTHÈQUE ET SUPPRESSION
       ============================================================ */
    function releaseLibraryCoverUrls() {
      for (const url of libraryCoverUrls) URL.revokeObjectURL(url);
      libraryCoverUrls.clear();
    }

    async function renderLibrary() {
      if (!db) return;
      const books = await db.books.toArray();
      books.sort((a, b) => {
        const recent = (b.lastOpenedAt || b.addedAt) - (a.lastOpenedAt || a.addedAt);
        return recent || naturalCollator.compare(a.title, b.title);
      });

      releaseLibraryCoverUrls();
      const grid = $("bookGrid");
      grid.replaceChildren();
      $("bookCount").textContent = `${books.length} livre${books.length > 1 ? "s" : ""}`;
      $("emptyState").hidden = books.length > 0;

      for (const book of books) {
        const card = document.createElement("article");
        card.className = "book-card";

        const coverWrap = document.createElement("div");
        coverWrap.className = "cover-wrap";

        const coverButton = document.createElement("button");
        coverButton.className = "cover-button";
        coverButton.setAttribute("aria-label", `Ouvrir ${book.title}`);
        coverButton.title = `${book.title} · ${formatLabel(book.format)}`;

        const image = document.createElement("img");
        image.alt = `Couverture de ${book.title}`;
        image.loading = "lazy";
        if (book.cover) {
          const url = URL.createObjectURL(book.cover);
          libraryCoverUrls.add(url);
          image.src = url;
        }
        coverButton.appendChild(image);

        const deleteButton = document.createElement("button");
        deleteButton.className = "delete-book";
        deleteButton.title = "Supprimer le livre";
        deleteButton.setAttribute("aria-label", `Supprimer ${book.title}`);
        deleteButton.innerHTML = '<svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg>';
        deleteButton.addEventListener("click", event => {
          event.stopPropagation();
          confirmBookDeletion(book);
        });

        coverWrap.append(coverButton, deleteButton);

        const title = document.createElement("h3");
        title.className = "book-title";
        title.textContent = book.title;
        const author = document.createElement("p");
        author.className = "book-author";
        author.textContent = `${book.author} · ${formatLabel(book.format)}`;

        card.append(coverWrap, title, author);
        if (book.progress > 0) {
          const progress = document.createElement("div");
          progress.className = "book-progress";
          progress.title = `${Math.round(book.progress * 100)} % lu`;
          const bar = document.createElement("span");
          bar.style.width = `${clamp(book.progress, 0, 1) * 100}%`;
          progress.appendChild(bar);
          card.appendChild(progress);
        }

        attachLongPress(coverButton, book);
        grid.appendChild(card);
      }
    }

    function attachLongPress(button, book) {
      let timer = 0;
      let longPressed = false;
      let startX = 0;
      let startY = 0;
      let suppressClickUntil = 0;

      const cancel = () => {
        clearTimeout(timer);
        timer = 0;
      };

      button.addEventListener("pointerdown", event => {
        if (event.button !== 0) return;
        cancel();
        longPressed = false;
        startX = event.clientX;
        startY = event.clientY;
        timer = setTimeout(() => {
          longPressed = true;
          suppressClickUntil = Date.now() + 800;
          navigator.vibrate?.(25);
          confirmBookDeletion(book);
        }, 650);
      });

      button.addEventListener("pointermove", event => {
        if (Math.hypot(event.clientX - startX, event.clientY - startY) > 12) cancel();
      });
      button.addEventListener("pointerup", cancel);
      button.addEventListener("pointercancel", cancel);
      button.addEventListener("pointerleave", cancel);

      button.addEventListener("contextmenu", event => {
        event.preventDefault();
        if (!longPressed) confirmBookDeletion(book);
      });

      button.addEventListener("click", event => {
        if (longPressed || Date.now() < suppressClickUntil) {
          event.preventDefault();
          longPressed = false;
          return;
        }
        openBook(book.id, { userGesture: true });
      });
    }

    let confirmResolver = null;

    function askConfirmation(title, message) {
      $("confirmTitle").textContent = title;
      $("confirmMessage").textContent = message;
      $("confirmModal").hidden = false;
      $("confirmCancelButton").focus();
      return new Promise(resolve => { confirmResolver = resolve; });
    }

    function finishConfirmation(value) {
      $("confirmModal").hidden = true;
      confirmResolver?.(value);
      confirmResolver = null;
    }

    async function confirmBookDeletion(book) {
      const accepted = await askConfirmation(
        "Supprimer ce livre ?",
        `« ${book.title} » et sa position de lecture seront définitivement retirés de cet appareil.`
      );
      if (!accepted) return;
      try {
        await db.books.delete(book.id);
        const resume = await db.settings.get("resumeBookId");
        if (resume?.value === book.id) await db.settings.put({ key: "resumeBookId", value: null });
        await renderLibrary();
        showToast(`« ${book.title} » a été supprimé.`);
      } catch (error) {
        showToast("Suppression impossible : " + error.message, 6000, true);
      }
    }

    /* ============================================================
       STATUT DE LECTURE ET SAUVEGARDE DES PAGES
       ============================================================ */
    function updateReaderStatus(label, progress = null) {
      $("pageIndicator").textContent = label;
      if (typeof progress === "number" && Number.isFinite(progress)) {
        $("readingProgressBar").style.width = `${clamp(progress, 0, 1) * 100}%`;
        $("readingProgressBar").parentElement.style.opacity = "1";
      } else {
        $("readingProgressBar").parentElement.style.opacity = ".45";
      }
    }

    function resetReaderViewports() {
      $("epubViewport").hidden = true;
      $("textViewport").hidden = true;
      $("comicViewport").hidden = true;
      $("epubViewport").replaceChildren();
      $("textContent").replaceChildren();
      $("comicImage").removeAttribute("src");
    }

    /* ============================================================
       MOTEUR EPUB.JS — CFI, THÈMES ET GESTES INTERNES
       ============================================================ */
    class EpubEngine {
      constructor(record) {
        this.record = record;
        this.book = null;
        this.rendition = null;
        this.location = null;
        this.destroyed = false;
      }

      async init() {
        if (!window.ePub) throw new Error("Epub.js n’est pas disponible.");
        $("epubViewport").hidden = false;
        await nextFrame();

        this.book = ePub(await this.record.file.arrayBuffer());
        await withTimeout(this.book.ready, 30000, "Le livre EPUB ne répond pas.");

        const viewport = $("epubViewport");
        this.rendition = this.book.renderTo(viewport, {
          width: Math.max(1, viewport.clientWidth),
          height: Math.max(1, viewport.clientHeight),
          flow: "paginated",
          spread: "none",
          allowScriptedContent: false
        });

        for (const theme of Object.keys(readerColors)) {
          const colors = readerColors[theme];
          this.rendition.themes.register("omni-" + theme, {
            "body": {
              "background": colors.paper + " !important",
              "color": colors.ink + " !important",
              "font-family": "'EB Garamond', Georgia, serif !important",
              "line-height": "1.7 !important",
              "text-align": "justify !important",
              "hyphens": "auto !important",
              "-webkit-hyphens": "auto !important",
              "padding": "0 5% !important"
            },
            "p": { "line-height": "1.7 !important", "margin": "0 0 .85em !important" },
            "a": { "color": colors.accent + " !important" },
            "img": { "max-width": "100% !important", "height": "auto !important" }
          });
        }

        this.setTheme();
        this.rendition.themes.font("'EB Garamond', Georgia, serif");
        this.rendition.themes.fontSize(prefs.fontSize + "px");

        this.rendition.hooks.content.register(contents => {
          try {
            this.prepareContents(contents);
          } catch (error) {
            console.warn("Préparation d’une section EPUB :", error);
          }
        });

        this.rendition.on("relocated", location => {
          if (this.destroyed || !location?.start) return;
          this.location = location;
          const cfi = location.start.cfi;
          const displayed = location.start.displayed;
          const percent = typeof location.start.percentage === "number"
            ? location.start.percentage
            : null;

          if (displayed?.total) {
            updateReaderStatus(`Section · ${displayed.page} / ${displayed.total}`, percent);
          } else {
            updateReaderStatus("Lecture EPUB", percent);
          }

          if (cfi) void persistPosition(this.record.id, { cfi }, percent);
        });

        const savedCfi = this.record.position?.cfi;
        try {
          await withTimeout(
            this.rendition.display(savedCfi || undefined),
            30000,
            "Le rendu de cette page EPUB a expiré."
          );
        } catch (error) {
          if (!savedCfi) throw error;
          showToast("L’ancienne position était illisible ; ouverture au début du livre.", 5000, true);
          await this.rendition.display();
        }
      }

      prepareContents(contents) {
        const doc = contents.document;
        if (!doc) return;

        doc.querySelectorAll("script, iframe, object, embed").forEach(node => node.remove());
        doc.querySelectorAll("[src]").forEach(node => {
          const src = node.getAttribute("src") || "";
          if (/^https?:\/\//i.test(src)) node.remove();
        });

        this.styleDocument(doc);
        bindEpubGestures(doc);
      }

      styleDocument(doc) {
        const colors = readerColors[prefs.theme];
        let style = doc.getElementById("omni-liseuse-style");
        if (!style) {
          style = doc.createElement("style");
          style.id = "omni-liseuse-style";
          (doc.head || doc.documentElement).appendChild(style);
        }
        style.textContent = `
          html, body {
            background: ${colors.paper} !important;
            color: ${colors.ink} !important;
          }
          body {
            font-family: 'EB Garamond', Georgia, serif !important;
            font-size: ${prefs.fontSize}px !important;
            line-height: 1.7 !important;
            text-align: justify !important;
            hyphens: auto !important;
            -webkit-hyphens: auto !important;
          }
          p, li { line-height: 1.7 !important; }
          a { color: ${colors.accent} !important; }
          img, svg { max-width: 100% !important; }
        `;
      }

      setTheme() {
        if (!this.rendition) return;
        this.rendition.themes.select("omni-" + prefs.theme);
        this.rendition.themes.fontSize(prefs.fontSize + "px");
        try {
          const contents = this.rendition.getContents?.() || [];
          for (const content of contents) {
            if (content.document) this.styleDocument(content.document);
          }
        } catch (_) {}
      }

      async fontChanged() {
        if (!this.rendition) return;
        const cfi = this.location?.start?.cfi;
        this.rendition.themes.fontSize(prefs.fontSize + "px");
        this.setTheme();
        const viewport = $("epubViewport");
        this.rendition.resize(Math.max(1, viewport.clientWidth), Math.max(1, viewport.clientHeight));
        if (cfi) {
          await sleep(40);
          if (!this.destroyed) await this.rendition.display(cfi);
        }
      }

      canGo(direction) {
        if (!this.location) return true;
        return direction > 0 ? !this.location.atEnd : !this.location.atStart;
      }

      async go(direction) {
        if (direction > 0) await this.rendition.next();
        else await this.rendition.prev();
      }

      resize() {
        if (!this.rendition || this.destroyed) return;
        const viewport = $("epubViewport");
        if (viewport.clientWidth && viewport.clientHeight) {
          this.rendition.resize(viewport.clientWidth, viewport.clientHeight);
        }
      }

      snapshot() { return null; }

      destroy() {
        this.destroyed = true;
        try { this.rendition?.destroy(); } catch (_) {}
        try { this.book?.destroy(); } catch (_) {}
        this.rendition = null;
        this.book = null;
      }
    }

    /* ============================================================
       MOTEUR TXT / HTML — PAGINATION PAR COLONNES CSS
       ============================================================ */
    function sanitizeHtml(source) {
      const doc = new DOMParser().parseFromString(source, "text/html");
      doc.querySelectorAll("script,style,iframe,object,embed,link,meta,base,form,input,button,video,audio,svg,math")
        .forEach(node => node.remove());

      doc.querySelectorAll("*").forEach(element => {
        for (const attribute of Array.from(element.attributes)) {
          const name = attribute.name.toLowerCase();
          const value = attribute.value.trim();
          if (name.startsWith("on") || name === "style" || name === "srcdoc") {
            element.removeAttribute(attribute.name);
          }
          if ((name === "href" || name === "src") && /^javascript:/i.test(value)) {
            element.removeAttribute(attribute.name);
          }
        }
      });

      doc.querySelectorAll("img").forEach(image => {
        const src = image.getAttribute("src") || "";
        if (!/^data:image\//i.test(src)) image.remove();
      });

      doc.querySelectorAll("a").forEach(link => {
        const href = link.getAttribute("href") || "";
        if (/^https?:\/\//i.test(href)) {
          link.removeAttribute("href");
          link.removeAttribute("target");
        }
      });

      return {
        html: doc.body.innerHTML,
        language: doc.documentElement.lang || ""
      };
    }

    class TextEngine {
      constructor(record) {
        this.record = record;
        this.page = 0;
        this.total = 1;
        this.width = 1;
        this.height = 1;
        this.gap = 40;
        this.ready = false;
        this.layoutTimer = 0;
      }

      async init() {
        const source = await decodeTextFile(this.record.file);
        const content = $("textContent");
        content.replaceChildren();

        if (this.record.format === "html") {
          const clean = sanitizeHtml(source);
          content.innerHTML = clean.html || "<p>Ce document ne contient aucun texte lisible.</p>";
          if (clean.language) content.lang = clean.language;
        } else {
          const normalized = source.replace(/\r\n?/g, "\n").replace(/\f/g, "\n\n");
          const blocks = normalized.split(/\n[\t ]*\n/);
          const fragment = document.createDocumentFragment();
          for (const block of blocks) {
            if (!block.trim()) continue;
            const paragraph = document.createElement("p");
            paragraph.textContent = block.trim();
            paragraph.style.whiteSpace = "pre-wrap";
            fragment.appendChild(paragraph);
          }
          if (!fragment.childNodes.length) {
            const paragraph = document.createElement("p");
            paragraph.textContent = "Ce document texte est vide.";
            fragment.appendChild(paragraph);
          }
          content.appendChild(fragment);
        }

        $("textViewport").hidden = false;
        await nextFrame();
        this.layout();

        content.querySelectorAll("img").forEach(image => {
          image.addEventListener("load", () => {
            clearTimeout(this.layoutTimer);
            this.layoutTimer = setTimeout(() => this.layout(), 100);
          }, { once: true });
        });
      }

      layout() {
        const viewport = $("textViewport");
        const content = $("textContent");
        if (!viewport.clientWidth || !viewport.clientHeight) return;

        const oldRatio = this.ready && this.total > 1 ? this.page / (this.total - 1) : (this.record.progress || 0);
        const restoredPage = clamp(Number(this.record.position?.page) || 0, 0, 1000000);

        this.width = Math.max(1, Math.floor(viewport.clientWidth));
        this.height = Math.max(1, Math.floor(viewport.clientHeight));
        this.gap = clamp(Math.round(this.width * .075), 28, 64);

        content.style.width = this.width + "px";
        content.style.height = this.height + "px";
        content.style.columnWidth = this.width + "px";
        content.style.columnGap = this.gap + "px";
        content.style.fontSize = prefs.fontSize + "px";
        content.style.transform = "translate3d(0,0,0)";

        const scrollWidth = Math.max(this.width, content.scrollWidth);
        const stride = this.width + this.gap;
        this.total = Math.max(1, Math.ceil((scrollWidth - this.width) / stride) + 1);

        this.page = this.ready
          ? clamp(Math.round(oldRatio * (this.total - 1)), 0, this.total - 1)
          : clamp(restoredPage, 0, this.total - 1);
        this.ready = true;
        this.applyPage(false);
      }

      applyPage(save = true) {
        const stride = this.width + this.gap;
        $("textContent").style.transform = `translate3d(${-this.page * stride}px,0,0)`;
        const progress = this.total > 1 ? this.page / (this.total - 1) : (this.page ? 1 : 0);
        updateReaderStatus(`Page ${this.page + 1} / ${this.total}`, progress);
        if (save) void persistPosition(this.record.id, { page: this.page }, progress);
      }

      canGo(direction) {
        return direction > 0 ? this.page < this.total - 1 : this.page > 0;
      }

      async go(direction) {
        if (!this.canGo(direction)) return;
        this.page += direction;
        this.applyPage(true);
      }

      resize() { this.layout(); }
      fontChanged() { this.layout(); }
      setTheme() {}

      snapshot() {
        const wrapper = document.createElement("div");
        wrapper.className = "snapshot-text";
        const clone = $("textContent").cloneNode(true);
        clone.removeAttribute("id");
        clone.setAttribute("aria-hidden", "true");
        clone.style.position = "absolute";
        clone.style.left = "0";
        clone.style.top = "0";
        clone.style.margin = "0";
        wrapper.appendChild(clone);
        return wrapper;
      }

      destroy() {
        clearTimeout(this.layoutTimer);
        $("textContent").replaceChildren();
      }
    }

    /* ============================================================
       MOTEUR CBZ / CBR — IMAGES À LA DEMANDE ET CACHE LIMITÉ
       ============================================================ */
    function flattenArchive(node, path, output, visited = new WeakSet()) {
      if (!node) return;
      if (node instanceof Blob) {
        output.push({ name: path || node.name || "page", blob: node });
        return;
      }
      if (typeof node !== "object") return;
      if (visited.has(node)) return;
      visited.add(node);

      if (node.file instanceof Blob) {
        output.push({
          name: (node.path || path || "") + (node.file.name || ""),
          blob: node.file
        });
        return;
      }

      if (Array.isArray(node)) {
        for (const child of node) flattenArchive(child, path, output, visited);
        return;
      }

      for (const [name, child] of Object.entries(node)) {
        flattenArchive(child, path ? path + "/" + name : name, output, visited);
      }
    }

    class ComicEngine {
      constructor(record) {
        this.record = record;
        this.pages = [];
        this.page = 0;
        this.zip = null;
        this.archive = null;
        this.loadToken = 0;
        this.destroyed = false;
      }

      async init() {
        if (this.record.format === "cbz") {
          if (!window.JSZip) throw new Error("JSZip n’est pas disponible pour ce CBZ.");
          this.zip = await JSZip.loadAsync(await this.record.file.arrayBuffer());
          const entries = comicImageNamesFromZip(this.zip);
          this.pages = entries.map(entry => ({ name: entry.name, entry, url: null, pending: null, used: 0 }));
        } else {
          await this.initCbr();
        }

        if (!this.pages.length) throw new Error("Aucune page image lisible dans cette bande dessinée.");
        this.page = clamp(Number(this.record.position?.page) || 0, 0, this.pages.length - 1);
        $("comicViewport").hidden = false;
        await this.showPage(this.page, false);
      }

      async initCbr() {
        if (!window.Archive) {
          throw new Error("Le module CBR n’est pas chargé. Une connexion est nécessaire à son premier chargement.");
        }

        if (!archiveInitialized) {
          archiveWorkerBlobUrl = URL.createObjectURL(new Blob(
            [`importScripts(${JSON.stringify(ARCHIVE_WORKER)});`],
            { type: "text/javascript" }
          ));
          Archive.init({ workerUrl: archiveWorkerBlobUrl });
          archiveInitialized = true;
        }

        const file = new File([this.record.file], this.record.title + ".cbr", {
          type: "application/vnd.comicbook-rar"
        });
        this.archive = await withTimeout(Archive.open(file), 120000, "L’extraction du CBR a expiré.");

        let extracted;
        try {
          extracted = await this.archive.extractFiles();
        } catch (error) {
          if (this.archive.getFilesArray) extracted = await this.archive.getFilesArray();
          else throw error;
        }

        const flattened = [];
        flattenArchive(extracted, "", flattened);
        this.pages = flattened
          .filter(item => imagePattern.test(item.name))
          .sort((a, b) => naturalCollator.compare(a.name, b.name))
          .map(item => ({ name: item.name, blob: item.blob, url: null, pending: null, used: 0 }));
      }

      async getUrl(index) {
        const descriptor = this.pages[index];
        if (!descriptor || this.destroyed) throw new Error("Page indisponible.");
        if (descriptor.url) {
          descriptor.used = Date.now();
          return descriptor.url;
        }
        if (descriptor.pending) return descriptor.pending;

        descriptor.pending = (async () => {
          const blob = descriptor.entry ? await descriptor.entry.async("blob") : descriptor.blob;
          if (this.destroyed) throw new Error("Lecture fermée.");
          if (!blob) throw new Error("Image introuvable dans l’archive.");
          descriptor.url = URL.createObjectURL(blob);
          descriptor.used = Date.now();
          descriptor.pending = null;
          this.pruneCache();
          return descriptor.url;
        })().catch(error => {
          descriptor.pending = null;
          throw error;
        });

        return descriptor.pending;
      }

      pruneCache() {
        for (let index = 0; index < this.pages.length; index++) {
          const descriptor = this.pages[index];
          if (descriptor.url && Math.abs(index - this.page) > 2) {
            URL.revokeObjectURL(descriptor.url);
            descriptor.url = null;
          }
        }
      }

      async showPage(index, save = true) {
        this.page = clamp(index, 0, this.pages.length - 1);
        const token = ++this.loadToken;
        const url = await this.getUrl(this.page);
        if (this.destroyed || token !== this.loadToken) return;

        const image = $("comicImage");
        image.src = url;
        image.alt = `Page ${this.page + 1} de ${this.record.title}`;
        try { await image.decode(); } catch (_) {
          if (!image.complete || !image.naturalWidth) {
            throw new Error(`La page ${this.page + 1} est une image corrompue ou non prise en charge.`);
          }
        }

        const progress = this.pages.length > 1 ? this.page / (this.pages.length - 1) : (this.page ? 1 : 0);
        updateReaderStatus(`Page ${this.page + 1} / ${this.pages.length}`, progress);
        if (save) void persistPosition(this.record.id, { page: this.page }, progress);

        for (const neighbor of [this.page + 1, this.page - 1, this.page + 2]) {
          if (neighbor >= 0 && neighbor < this.pages.length) {
            this.getUrl(neighbor).catch(() => {});
          }
        }
      }

      canGo(direction) {
        return direction > 0 ? this.page < this.pages.length - 1 : this.page > 0;
      }

      async go(direction) {
        if (!this.canGo(direction)) return;
        await this.showPage(this.page + direction, true);
      }

      resize() {}
      fontChanged() {}
      setTheme() {}

      snapshot() {
        const image = document.createElement("img");
        image.className = "snapshot-comic";
        image.src = $("comicImage").src;
        image.alt = "";
        return image;
      }

      destroy() {
        this.destroyed = true;
        this.loadToken++;
        for (const descriptor of this.pages) {
          if (descriptor.url) URL.revokeObjectURL(descriptor.url);
          descriptor.url = null;
        }
        this.pages = [];
        this.zip = null;
        try {
          const result = this.archive?.close?.();
          result?.catch?.(() => {});
        } catch (_) {}
        this.archive = null;
        $("comicImage").removeAttribute("src");
      }
    }

    /* ============================================================
       OUVERTURE, FERMETURE ET REPRISE AUTOMATIQUE
       ============================================================ */
    async function openBook(bookId, options = {}) {
      if (opening) return;
      opening = true;
      if (options.userGesture) void requestFullscreen(false);

      const token = ++sessionToken;
      let engine = null;

      try {
        const record = await db.books.get(bookId);
        if (!record?.file) throw new Error("Le livre n’existe plus dans la bibliothèque.");

        if (current?.engine) current.engine.destroy();
        current = { record, engine: null };

        $("libraryView").hidden = true;
        $("readerView").hidden = false;
        $("readerView").classList.remove("chrome-hidden");
        $("readerBookTitle").textContent = record.title;
        $("readerLoadingText").textContent = `Ouverture de « ${record.title} »…`;
        $("readerLoading").hidden = false;
        resetReaderViewports();
        updateReaderStatus("Préparation…", null);

        await db.settings.put({ key: "lastBookId", value: bookId });
        await db.settings.put({ key: "resumeBookId", value: bookId });

        if (record.format === "epub") engine = new EpubEngine(record);
        else if (record.format === "txt" || record.format === "html") engine = new TextEngine(record);
        else engine = new ComicEngine(record);

        await engine.init();

        if (token !== sessionToken) {
          engine.destroy();
          return;
        }

        current.engine = engine;
        $("readerLoading").hidden = true;
        fullscreenPending = !options.userGesture && !document.fullscreenElement;
        scheduleChromeHide();
      } catch (error) {
        console.error("Ouverture impossible :", error);
        try { engine?.destroy(); } catch (_) {}
        if (token === sessionToken) {
          current = null;
          resetReaderViewports();
          $("readerView").hidden = true;
          $("libraryView").hidden = false;
          await db.settings.put({ key: "resumeBookId", value: null });
          await renderLibrary();
          const title = $("readerBookTitle").textContent || "Ce livre";
          showToast(`Impossible d’ouvrir « ${title} ». ${error.message || "Le fichier est peut-être corrompu."}`, 8000, true);
        }
      } finally {
        opening = false;
      }
    }

    async function closeReader() {
      sessionToken++;
      clearTimeout(chromeTimer);
      closeSettings();

      const engine = current?.engine;
      current = null;
      navigationBusy = false;
      queuedDirection = 0;
      fullscreenPending = false;

      try { engine?.destroy(); } catch (error) { console.warn(error); }
      resetReaderViewports();
      $("readerLoading").hidden = true;
      $("readerView").hidden = true;
      $("libraryView").hidden = false;

      if (db) {
        await db.settings.put({ key: "resumeBookId", value: null });
        await renderLibrary();
      }
    }

    /* ============================================================
       NAVIGATION ET ANIMATION DE TOURNEPAGE
       ============================================================ */
    function makePaperAbstract() {
      const abstract = document.createElement("div");
      abstract.className = "paper-abstract";
      for (let index = 0; index < 13; index++) abstract.appendChild(document.createElement("span"));
      return abstract;
    }

    async function playPageTurn(direction, action, engine) {
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const supports3d = CSS.supports("transform-style", "preserve-3d") && CSS.supports("backface-visibility", "hidden");
      const layer = $("turnLayer");
      const leaf = $("turnLeaf");
      const front = $("leafFront");
      const shadow = $("pageShadow");
      const surface = $("readerSurface");

      if (reduceMotion || !supports3d || !leaf.animate) {
        const animation = surface.animate([
          { opacity: 1, transform: "translateX(0)" },
          { opacity: .25, transform: `translateX(${direction > 0 ? -14 : 14}px)`, offset: .48 },
          { opacity: 1, transform: "translateX(0)" }
        ], { duration: reduceMotion ? 150 : 240, easing: "ease-out" });

        const navigation = (async () => {
          await sleep(reduceMotion ? 30 : 105);
          await action();
        })();
        await Promise.all([animation.finished.catch(() => {}), navigation]);
        return;
      }

      front.replaceChildren();
      let snapshot = null;
      try { snapshot = engine.snapshot?.(); } catch (_) {}
      front.appendChild(snapshot || makePaperAbstract());

      layer.classList.add("active");
      leaf.className = direction > 0 ? "next" : "previous";
      shadow.className = direction > 0 ? "" : "previous";

      const degrees = direction > 0 ? -179 : 179;
      const leafAnimation = leaf.animate([
        { transform: "rotateY(0deg)", opacity: 0, offset: 0 },
        { transform: "rotateY(0deg)", opacity: 1, offset: .025 },
        { transform: `rotateY(${degrees * .30}deg)`, opacity: 1, offset: .32 },
        { transform: `rotateY(${degrees * .72}deg)`, opacity: 1, offset: .74 },
        { transform: `rotateY(${degrees}deg)`, opacity: 0, offset: 1 }
      ], {
        duration: 350,
        easing: "cubic-bezier(.28,.68,.26,1)",
        fill: "forwards"
      });

      const shadowAnimation = shadow.animate([
        { opacity: 0, transform: "translateX(0)" },
        { opacity: .12, offset: .25 },
        { opacity: .42, offset: .58 },
        { opacity: 0, transform: `translateX(${direction > 0 ? -8 : 8}%)` }
      ], { duration: 350, easing: "ease-in-out", fill: "forwards" });

      const navigation = (async () => {
        await sleep(112);
        await action();
      })();

      try {
        await Promise.all([
          leafAnimation.finished.catch(() => {}),
          shadowAnimation.finished.catch(() => {}),
          navigation
        ]);
      } finally {
        leafAnimation.cancel();
        shadowAnimation.cancel();
        layer.classList.remove("active");
        leaf.style.opacity = "";
        front.replaceChildren();
      }
    }

    function edgeFeedback(direction) {
      $("readerSurface").animate([
        { transform: "translateX(0)" },
        { transform: `translateX(${direction > 0 ? -7 : 7}px)` },
        { transform: "translateX(0)" }
      ], { duration: 180, easing: "ease-out" });
    }

    async function navigate(direction) {
      const engine = current?.engine;
      if (!engine || opening) return;

      if (navigationBusy) {
        queuedDirection = direction;
        return;
      }

      if (engine.canGo && !engine.canGo(direction)) {
        edgeFeedback(direction);
        return;
      }

      navigationBusy = true;
      showReaderChrome();
      try {
        await playPageTurn(direction, () => engine.go(direction), engine);
      } catch (error) {
        console.error("Changement de page :", error);
        showToast("Cette page n’a pas pu être affichée : " + (error.message || "erreur de rendu"), 6000, true);
      } finally {
        navigationBusy = false;
        if (queuedDirection) {
          const nextDirection = queuedDirection;
          queuedDirection = 0;
          setTimeout(() => navigate(nextDirection), 0);
        }
      }
    }

    /* ============================================================
       SWIPE, ZONES DE TAP ET COMMANDES CLAVIER
       ============================================================ */
    let outerGesture = null;

    function setupOuterGestures() {
      const stage = $("readerStage");

      stage.addEventListener("pointerdown", event => {
        if (event.button !== 0) return;
        outerGesture = {
          id: event.pointerId,
          x: event.clientX,
          y: event.clientY,
          time: performance.now(),
          horizontal: false
        };
        try { stage.setPointerCapture(event.pointerId); } catch (_) {}

        if (fullscreenPending) {
          fullscreenPending = false;
          void requestFullscreen(false);
        }
      });

      stage.addEventListener("pointermove", event => {
        const gesture = outerGesture;
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy) * 1.15) {
          gesture.horizontal = true;
          event.preventDefault();
        }
      }, { passive: false });

      const finish = event => {
        const gesture = outerGesture;
        if (!gesture || gesture.id !== event.pointerId) return;
        outerGesture = null;
        if (!gesture.horizontal) return;

        const dx = event.clientX - gesture.x;
        const elapsed = Math.max(1, performance.now() - gesture.time);
        const velocity = Math.abs(dx) / elapsed;
        const threshold = Math.min(75, Math.max(42, stage.clientWidth * .07));

        if (Math.abs(dx) >= threshold || (Math.abs(dx) > 28 && velocity > .38)) {
          suppressTapUntil = Date.now() + 450;
          navigate(dx < 0 ? 1 : -1);
        }
      };

      stage.addEventListener("pointerup", finish);
      stage.addEventListener("pointercancel", () => { outerGesture = null; });

      $("tapLeft").addEventListener("click", () => {
        if (Date.now() >= suppressTapUntil) navigate(-1);
      });
      $("tapRight").addEventListener("click", () => {
        if (Date.now() >= suppressTapUntil) navigate(1);
      });
      $("tapCenter").addEventListener("click", () => {
        if (Date.now() < suppressTapUntil) return;
        const hidden = $("readerView").classList.toggle("chrome-hidden");
        if (!hidden) scheduleChromeHide();
      });
    }

    function bindEpubGestures(doc) {
      let gesture = null;
      let suppressClickUntil = 0;

      doc.addEventListener("touchstart", event => {
        if (event.touches.length !== 1) return;
        const touch = event.touches[0];
        gesture = { x: touch.clientX, y: touch.clientY, time: performance.now(), horizontal: false };
      }, { passive: true });

      doc.addEventListener("touchmove", event => {
        if (!gesture || !event.touches.length) return;
        const touch = event.touches[0];
        const dx = touch.clientX - gesture.x;
        const dy = touch.clientY - gesture.y;
        if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy) * 1.15) {
          gesture.horizontal = true;
          event.preventDefault();
        }
      }, { passive: false });

      doc.addEventListener("touchend", event => {
        if (!gesture?.horizontal || !event.changedTouches.length) {
          gesture = null;
          return;
        }
        const touch = event.changedTouches[0];
        const dx = touch.clientX - gesture.x;
        const elapsed = Math.max(1, performance.now() - gesture.time);
        if (Math.abs(dx) > 45 || (Math.abs(dx) > 28 && Math.abs(dx) / elapsed > .38)) {
          suppressClickUntil = Date.now() + 450;
          navigate(dx < 0 ? 1 : -1);
        }
        gesture = null;
      }, { passive: true });

      doc.addEventListener("click", event => {
        const anchor = event.target.closest?.("a");
        if (anchor) {
          const href = anchor.getAttribute("href") || "";
          if (/^https?:\/\//i.test(href)) {
            event.preventDefault();
            showToast("Les liens externes sont désactivés pendant la lecture locale.");
          }
          return;
        }
        if (event.defaultPrevented || Date.now() < suppressClickUntil) return;

        const width = doc.documentElement.clientWidth || doc.body.clientWidth || 1;
        const ratio = event.clientX / width;
        if (ratio < .22) navigate(-1);
        else if (ratio > .78) navigate(1);
        else {
          const hidden = $("readerView").classList.toggle("chrome-hidden");
          if (!hidden) scheduleChromeHide();
        }
      });

      doc.addEventListener("keydown", event => {
        if (event.key === "ArrowRight" || event.key === "PageDown" || event.key === " ") {
          event.preventDefault();
          navigate(1);
        }
        if (event.key === "ArrowLeft" || event.key === "PageUp") {
          event.preventDefault();
          navigate(-1);
        }
      });
    }

    /* ============================================================
       PLEIN ÉCRAN ET AFFICHAGE DES COMMANDES
       ============================================================ */
    async function requestFullscreen(notify = true) {
      const element = document.documentElement;
      const request = element.requestFullscreen || element.webkitRequestFullscreen;
      if (!request) {
        if (notify) showToast("Le plein écran n’est pas proposé par ce navigateur. Le mode PWA reste disponible.");
        return false;
      }
      try {
        await request.call(element, { navigationUI: "hide" });
        return true;
      } catch (error) {
        console.info("Plein écran refusé :", error);
        if (notify) showToast("Le navigateur a refusé le plein écran. La lecture reste disponible normalement.");
        return false;
      }
    }

    async function toggleFullscreen() {
      if (document.fullscreenElement || document.webkitFullscreenElement) {
        const exit = document.exitFullscreen || document.webkitExitFullscreen;
        try { await exit?.call(document); } catch (_) {}
      } else {
        await requestFullscreen(true);
      }
    }

    function showReaderChrome() {
      $("readerView").classList.remove("chrome-hidden");
      scheduleChromeHide();
    }

    function scheduleChromeHide() {
      clearTimeout(chromeTimer);
      if (!current?.engine || !$("settingsPanel").hidden) return;
      chromeTimer = setTimeout(() => {
        if (current?.engine && $("settingsPanel").hidden && $("aboutModal").hidden) {
          $("readerView").classList.add("chrome-hidden");
        }
      }, 4200);
    }

    /* ============================================================
       PANNEAUX, RÉGLAGES ET ÉVÉNEMENTS GÉNÉRAUX
       ============================================================ */
    function openSettings() {
      clearTimeout(chromeTimer);
      $("panelBackdrop").hidden = false;
      $("settingsPanel").hidden = false;
      $("closeSettingsButton").focus();
    }

    function closeSettings() {
      $("panelBackdrop").hidden = true;
      $("settingsPanel").hidden = true;
    }

    function showAbout() {
      closeSettings();
      $("aboutModal").hidden = false;
      $("closeAboutButton").focus();
    }

    function closeAbout() {
      $("aboutModal").hidden = true;
    }

    function changeFont(delta) {
      const next = clamp(prefs.fontSize + delta, 14, 28);
      if (next === prefs.fontSize) return;
      prefs.fontSize = next;
      applyFontSize(true);
      void savePreference("fontSize", prefs.fontSize);
    }

    function setWarmth(value, persist = true) {
      prefs.warmth = clamp(Math.round(value / 5) * 5, 0, 45);
      if (prefs.warmth > 0) prefs.lastWarmth = prefs.warmth;
      applyWarmth();
      if (persist) {
        void savePreference("warmth", prefs.warmth);
        void savePreference("lastWarmth", prefs.lastWarmth);
      }
    }

    function bindInterface() {
      $("importButton").addEventListener("click", () => $("fileInput").click());
      $("fileInput").addEventListener("change", event => importFiles(Array.from(event.target.files || [])));

      const dropZone = $("dropZone");
      for (const type of ["dragenter", "dragover"]) {
        dropZone.addEventListener(type, event => {
          event.preventDefault();
          if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
          dropZone.classList.add("dragging");
        });
      }
      dropZone.addEventListener("dragleave", event => {
        if (!dropZone.contains(event.relatedTarget)) dropZone.classList.remove("dragging");
      });
      dropZone.addEventListener("drop", event => {
        event.preventDefault();
        dropZone.classList.remove("dragging");
        importFiles(Array.from(event.dataTransfer?.files || []));
      });

      window.addEventListener("dragover", event => event.preventDefault());
      window.addEventListener("drop", event => {
        if (!dropZone.contains(event.target)) event.preventDefault();
      });

      $("librarySettingsButton").addEventListener("click", openSettings);
      $("readerSettingsButton").addEventListener("click", openSettings);
      $("closeSettingsButton").addEventListener("click", closeSettings);
      $("panelBackdrop").addEventListener("click", closeSettings);
      $("aboutButton").addEventListener("click", showAbout);
      $("settingsAboutButton").addEventListener("click", showAbout);
      $("closeAboutButton").addEventListener("click", closeAbout);
      $("aboutModal").addEventListener("click", event => {
        if (event.target === $("aboutModal")) closeAbout();
      });

      $("confirmCancelButton").addEventListener("click", () => finishConfirmation(false));
      $("confirmAcceptButton").addEventListener("click", () => finishConfirmation(true));
      $("confirmModal").addEventListener("click", event => {
        if (event.target === $("confirmModal")) finishConfirmation(false);
      });

      document.querySelectorAll("[data-set-theme]").forEach(button => {
        button.addEventListener("click", () => {
          prefs.theme = button.dataset.setTheme;
          applyTheme();
          void savePreference("theme", prefs.theme);
        });
      });

      $("fontMinusButton").addEventListener("click", () => changeFont(-1));
      $("fontPlusButton").addEventListener("click", () => changeFont(1));

      $("warmthRange").addEventListener("input", event => setWarmth(Number(event.target.value), false));
      $("warmthRange").addEventListener("change", event => setWarmth(Number(event.target.value), true));
      $("toggleWarmthButton").addEventListener("click", () => setWarmth(prefs.warmth ? 0 : prefs.lastWarmth));
      $("warmQuickButton").addEventListener("click", () => setWarmth(prefs.warmth ? 0 : prefs.lastWarmth));

      $("fullscreenButton").addEventListener("click", toggleFullscreen);
      document.addEventListener("fullscreenchange", () => {
        $("fullscreenButton").textContent = document.fullscreenElement ? "Quitter le plein écran" : "Passer en plein écran";
      });

      $("readerBackButton").addEventListener("click", closeReader);
      setupOuterGestures();

      window.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          if (!$("confirmModal").hidden) finishConfirmation(false);
          else if (!$("aboutModal").hidden) closeAbout();
          else if (!$("settingsPanel").hidden) closeSettings();
          else if (current) showReaderChrome();
          return;
        }

        if (!current?.engine || !$("settingsPanel").hidden || !$("aboutModal").hidden) return;
        if (/INPUT|TEXTAREA|SELECT/.test(event.target.tagName)) return;

        if (event.key === "ArrowRight" || event.key === "PageDown" || event.key === " ") {
          event.preventDefault();
          navigate(1);
        } else if (event.key === "ArrowLeft" || event.key === "PageUp") {
          event.preventDefault();
          navigate(-1);
        } else if (event.key === "+" || event.key === "=") {
          changeFont(1);
        } else if (event.key === "-") {
          changeFont(-1);
        }
      });

      window.addEventListener("beforeinstallprompt", event => {
        event.preventDefault();
        deferredInstallPrompt = event;
        $("installButton").hidden = false;
      });

      $("installButton").addEventListener("click", async () => {
        if (!deferredInstallPrompt) return;
        deferredInstallPrompt.prompt();
        await deferredInstallPrompt.userChoice;
        deferredInstallPrompt = null;
        $("installButton").hidden = true;
      });

      window.addEventListener("appinstalled", () => {
        deferredInstallPrompt = null;
        $("installButton").hidden = true;
        showToast("Omni-Liseuse a été installée sur l’écran d’accueil.");
      });

      window.addEventListener("offline", () => showToast("Mode hors ligne : vos livres locaux restent accessibles."));
      window.addEventListener("online", () => showToast("Connexion rétablie."));

      let resizeTimer = 0;
      const resizeObserver = new ResizeObserver(() => {
        if (!current?.engine) return;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          Promise.resolve(current?.engine?.resize?.()).catch(error => console.warn("Redimensionnement :", error));
        }, 140);
      });
      resizeObserver.observe($("readerSurface"));

      window.addEventListener("orientationchange", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => current?.engine?.resize?.(), 240);
      });

      document.fonts?.ready.then(() => current?.engine?.resize?.()).catch(() => {});
    }

    /* ============================================================
       DÉMARRAGE DE L’APPLICATION
       ============================================================ */
    async function boot() {
      setupIconsAndManifest();
      bindInterface();
      applyTheme();
      applyWarmth();
      applyFontSize(false);

      if (!window.Dexie) {
        $("importButton").disabled = true;
        $("emptyState").innerHTML = "<strong>Stockage local indisponible</strong>Dexie.js n’a pas pu être chargé. Vérifiez la connexion lors du premier chargement, puis rechargez la page.";
        showToast("Dexie.js est indispensable à la bibliothèque locale.", 8000, true);
        return;
      }

      try {
        createDatabase();
        await db.open();
        await loadPreferences();
        applyTheme();
        applyWarmth();
        applyFontSize(false);
        await renderLibrary();
      } catch (error) {
        console.error("Initialisation IndexedDB :", error);
        $("importButton").disabled = true;
        $("emptyState").innerHTML = "<strong>La bibliothèque ne peut pas démarrer</strong>Le stockage local est bloqué ou indisponible. Autorisez le stockage du site, puis rechargez.";
        showToast("IndexedDB est indisponible : " + error.message, 8000, true);
        return;
      }

      void setupServiceWorker();

      const resume = await db.settings.get("resumeBookId");
      if (resume?.value) {
        const book = await db.books.get(resume.value);
        if (book) {
          setTimeout(() => openBook(book.id, { userGesture: false, automatic: true }), 180);
        } else {
          await db.settings.put({ key: "resumeBookId", value: null });
        }
      }
    }

    boot().catch(error => {
      console.error("Erreur de démarrage :", error);
      showToast("Omni-Liseuse n’a pas pu démarrer correctement : " + error.message, 9000, true);
    });
  })();
  </script>
</body>
</html>
